<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - FoodTable</title>

    @Styles.Render("~/Content/css")

    <style>
        body {
            background-color: #f7f2ec;
            color: #30231d;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .food-navbar {
            background-color: #642b1c;
            box-shadow: 0 3px 14px rgba(50, 20, 10, .2);
        }

            .food-navbar .navbar-brand {
                color: #fff;
                font-size: 1.4rem;
                font-weight: 700;
            }

            .food-navbar .nav-link {
                color: #fff;
            }

                .food-navbar .nav-link:hover,
                .food-navbar .nav-link:focus {
                    color: #ffd9b4;
                }
            .food-navbar .nav-link {
                color: #fff;
                font-size: 1.15rem;
            }

        .page-content {
            padding-top: 90px;
            min-height: 75vh;
        }

        /* Footer nhiều cột: giới thiệu, liên kết và thông tin website */
        .site-footer {
            margin-top: 4rem;
            padding: 2.75rem 0 1.25rem;
            color: #30231d;
            background: #fff;
            border-top: 1px solid #eadbcf;
        }

        .footer-top {
            padding-bottom: 2rem;
        }

        .footer-brand {
            display: inline-block;
            margin-bottom: .75rem;
            color: #b14322;
            font-size: 1.8rem;
            font-weight: 800;
            font-style: italic;
            text-decoration: none;
        }

        .footer-brand:hover {
            color: #873317;
        }

        .footer-description,
        .footer-info-copy {
            color: #6c625c;
            line-height: 1.7;
        }

        .footer-heading {
            margin-bottom: 1rem;
            color: #30231d;
            font-size: 1.05rem;
            font-weight: 700;
        }

        .footer-links {
            display: grid;
            gap: .55rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .footer-links a {
            color: #6c625c;
            text-decoration: none;
            transition: color .2s ease;
        }

        .footer-links a:hover,
        .footer-links a:focus {
            color: #b14322;
            text-decoration: underline;
        }

        .footer-info {
            padding-top: 1.5rem;
            border-top: 1px solid #eadbcf;
        }

        .footer-info-title {
            margin-bottom: .75rem;
            font-size: 1rem;
            font-weight: 700;
        }

        .footer-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: .75rem;
        }

        .footer-action-link {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .65rem 1rem;
            color: #fff;
            background: #a94321;
            border: 1px solid #a94321;
            border-radius: .5rem;
            text-decoration: none;
            transition: background .2s ease;
        }

        .footer-action-link:hover,
        .footer-action-link:focus {
            color: #fff;
            background: #873317;
        }

        .footer-top-link {
            color: #6c625c;
            text-decoration: none;
        }

        .footer-top-link:hover,
        .footer-top-link:focus {
            color: #b14322;
        }

        @@media (max-width: 767.98px) {
            .site-footer {
                margin-top: 2.5rem;
                padding-top: 2rem;
            }

            .footer-actions {
                justify-content: flex-start;
            }
        }
        .food-navbar .booking-link,
        .food-navbar .account-link {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .5rem .8rem;
            border-radius: .45rem;
            text-decoration: none;
        }

        .food-navbar .booking-link {
            color: #fff;
            background: #a94321;
            border: 1px solid #d47b60;
        }

            .food-navbar .booking-link:hover {
                color: #fff;
                background: #873317;
            }


        .food-navbar .account-link {
            color: #fff;
        }

            .food-navbar .account-link:hover {
                color: #ffd9b4;
            }
    </style>
</head>
<body id="top">
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top food-navbar">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                ♨ FoodTable
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#nha-hang">
                            Nhà hàng
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#am-thuc">
                            Ẩm thực
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#dat-ban">
                            Đặt bàn
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#lien-he">
                            Liên hệ
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="nav-link booking-link" href="#">
                            <svg width="20" height="20" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                <path d="M16 3v4M8 3v4M3 11h18"></path>
                                <path d="m9 16 2 2 4-4"></path>
                            </svg>
                            Đặt chỗ của tôi
                        </a>
                    </li>

                    <li class="nav-item ms-lg-2">
                        <a class="nav-link account-link" href="#">
                            <svg width="20" height="20" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <circle cx="12" cy="8" r="4"></circle>
                                <path d="M5 21a7 7 0 0 1 14 0"></path>
                            </svg>
                            Tài khoản
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container page-content">
        @RenderBody()
    </main>

    @* Footer nhiều cột, phù hợp với nội dung FoodTable. *@
    <footer class="site-footer" id="lien-he">
        <div class="container">
            <div class="row g-4 footer-top">
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="footer-brand" href="@Url.Action("Index", "Home")">
                        <span aria-hidden="true">♨</span> FoodTable
                    </a>
                    <p class="footer-description mb-0">
                        Khám phá nhà hàng, lựa chọn món ngon và gửi yêu cầu đặt bàn dễ dàng.
                        Tìm địa điểm phù hợp cho buổi gặp mặt tiếp theo của bạn.
                    </p>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h2 class="footer-heading">Khám phá</h2>
                    <ul class="footer-links">
                        <li><a href="@Url.Action("Index", "Home")#nha-hang">Tìm nhà hàng</a></li>
                        <li><a href="@Url.Action("Index", "Home")#am-thuc">Loại ẩm thực</a></li>
                        <li><a href="@Url.Action("Index", "Home")#nha-hang">Nhà hàng nổi bật</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h2 class="footer-heading">Đặt bàn</h2>
                    <ul class="footer-links">
                        <li><a href="@Url.Action("Index", "Home")#dat-ban">Gửi yêu cầu đặt bàn</a></li>
                        <li><a href="@Url.Action("Index", "Home")#dat-ban">Chọn ngày và giờ</a></li>
                        <li><a href="@Url.Action("Index", "Home")#dat-ban">Thông tin liên hệ</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h2 class="footer-heading">Thông tin</h2>
                    <ul class="footer-links">
                        <li><a href="@Url.Action("Index", "Home")#lien-he">Về FoodTable</a></li>
                        <li><a href="@Url.Action("Index", "Home")#lien-he">Thông tin website</a></li>
                        <li><a href="@Url.Action("Index", "Home")#lien-he">Liên hệ</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h2 class="footer-heading">Dành cho nhà hàng</h2>
                    <ul class="footer-links">
                        <li><a href="@Url.Action("Index", "Home")#lien-he">Giới thiệu nhà hàng</a></li>
                        <li><a href="@Url.Action("Index", "Home")#lien-he">Hợp tác cùng FoodTable</a></li>
                        <li><a href="@Url.Action("Index", "Home")#lien-he">Gửi thông tin địa điểm</a></li>
                    </ul>
                </div>
            </div>

            <div class="row align-items-center g-3 footer-info">
                <div class="col-lg-8">
                    <h2 class="footer-info-title">THÔNG TIN FOODTABLE</h2>
                    <p class="footer-info-copy mb-2">
                        FoodTable là website giới thiệu nhà hàng và hỗ trợ gửi yêu cầu đặt bàn.
                        Thông tin nhà hàng và đặt chỗ trên trang hiện là dữ liệu minh họa.
                    </p>
                    <p class="footer-info-copy mb-0">
                        © @DateTime.Now.Year FoodTable · Dự án website mẫu
                    </p>
                </div>
                <div class="col-lg-4">
                    <div class="footer-actions">
                        <a class="footer-action-link" href="@Url.Action("Index", "Home")#nha-hang">
                            Khám phá nhà hàng <span aria-hidden="true">→</span>
                        </a>
                        <a class="footer-top-link" href="#top" aria-label="Quay lại đầu trang">
                            ↑ Lên đầu trang
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    @Scripts.Render("~/bundles/jquery")
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>