<section id="dat-ban" class="mt-5">
    <div class="booking-experience">
        <aside class="booking-visual">
            <img src="@Url.Content("~/Content/IMG/Hero/restaurant-1.png")"
                 alt="Không gian ấm cúng của nhà hàng" />
