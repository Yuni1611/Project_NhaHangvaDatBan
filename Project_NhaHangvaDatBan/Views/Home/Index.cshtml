                        <div class="booking-summary-row">
                            <span>Số điện thoại</span><span id="summaryPhone"></span>
                        </div>
                        <div class="booking-summary-row">
                            <span>Yêu cầu đặc biệt</span><span id="summarySpecial"></span>
