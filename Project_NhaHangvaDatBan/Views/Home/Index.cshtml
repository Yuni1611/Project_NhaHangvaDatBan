                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section scripts {
    <script>
        (function () {
            // Lấy các ô tìm kiếm, bộ lọc, thẻ nhà hàng và khu vực chi tiết.
            const searchInput = document.getElementById("searchInput");
            const searchButton = document.getElementById("searchButton");
            const areaFilter = document.getElementById("areaFilter");
            const cuisineFilter = document.getElementById("cuisineFilter");
            const priceFilter = document.getElementById("priceFilter");
            const purposeFilter = document.getElementById("purposeFilter");
            const restaurantItems = document.querySelectorAll(".restaurant-item");
            const noResults = document.getElementById("noResults");
            const cuisineButtons = document.querySelectorAll(".cuisine-chip");
            const detailSection = document.getElementById("chi-tiet");
            const detailImage = document.getElementById("detailImage");

            // Khi bấm Xem chi tiết, đọc dữ liệu từ đúng thẻ nhà hàng đó.
            document.getElementById("restaurantList")
                .addEventListener("click", function (event) {
                    const detailLink = event.target.closest('a[href="#chi-tiet"]');

                    if (!detailLink) {
                        return;
                    }

                    event.preventDefault();

                    const restaurant = detailLink.closest(".restaurant-item");
                    const name = restaurant.querySelector(".card-title").textContent.trim();
                    const image = restaurant.querySelector(".card-img-top");
                    const meta = restaurant.querySelector(".text-secondary.mb-2");
                    const rating = restaurant.querySelector(".restaurant-rating");
                    const description = restaurant.querySelector(".card-text");
                    const price = Number(restaurant.dataset.price || 0);
                    const purposes = (restaurant.dataset.purpose || "")
                        .split("|")
                        .join(" · ");

                    detailImage.src = image.src;
                    detailImage.alt = "Ảnh nhà hàng " + name;

                    document.getElementById("detailName").textContent = name;
                    document.getElementById("detailMeta").textContent =
                        meta ? meta.textContent.trim() : "";
                    document.getElementById("detailRating").textContent =
                        rating ? rating.textContent.trim().replace(/\s+/g, " ") : "";
                    document.getElementById("detailDescription").textContent =
                        description ? description.textContent.trim() : "";
                    document.getElementById("detailPrice").textContent = price
                        ? (price * 1000).toLocaleString("vi-VN") + "đ/người"
                        : "Chưa cập nhật";
                    document.getElementById("detailPurpose").textContent =
                        purposes || "Chưa cập nhật";

                    detailSection.classList.remove("d-none");
                    detailSection.scrollIntoView({
                        behavior: "smooth",
                        block: "nearest"
                    });
                });

            // Đóng khung thông tin chi tiết đang hiển thị.
            document.getElementById("closeDetail")
                .addEventListener("click", function () {
                    detailSection.classList.add("d-none");
                });

            // Kiểm tra giá của nhà hàng có nằm trong khoảng giá đã chọn không.
            function priceMatches(price, range) {
                if (range === "") {
                    return true;
                }

                if (range.endsWith("+")) {
                    return price >= Number(range.slice(0, -1));
                }

                const parts = range.split("-");
                const min = Number(parts[0]);
                const max = Number(parts[1]);

                return price >= min && price < max;
            }

            // Đồng bộ trạng thái sáng/tắt của các nút ẩm thực.
            function updateCuisineButtons() {
                cuisineButtons.forEach(function (button) {
                    const isSelected =
                        button.dataset.cuisine === cuisineFilter.value;

                    button.classList.toggle("active", isSelected);
                    button.setAttribute("aria-pressed", isSelected);
                });
            }

            // Lọc nhà hàng theo từ khóa, khu vực, ẩm thực, giá và mục đích.
            function filterRestaurants() {
                const searchText = searchInput.value.trim().toLowerCase();
                const selectedArea = areaFilter.value;
                const selectedCuisine = cuisineFilter.value;
                const selectedPrice = priceFilter.value;
                const selectedPurpose = purposeFilter.value;
                let visibleCount = 0;

                restaurantItems.forEach(function (item) {
                    const matchesText =
                        item.textContent.toLowerCase().includes(searchText);

                    const matchesArea =
                        selectedArea === "" ||
                        item.dataset.area === selectedArea;

                    const matchesCuisine =
                        selectedCuisine === "" ||
                        item.dataset.cuisine === selectedCuisine;

                    const itemPrice = Number(item.dataset.price || 0);
                    const matchesPrice =
                        priceMatches(itemPrice, selectedPrice);

                    const itemPurposes =
                        (item.dataset.purpose || "").split("|");

                    const matchesPurpose =
                        selectedPurpose === "" ||
                        itemPurposes.includes(selectedPurpose);

                    const shouldShow =
                        matchesText &&
                        matchesArea &&
                        matchesCuisine &&
                        matchesPrice &&
                        matchesPurpose;

                    item.classList.toggle("d-none", !shouldShow);

                    if (shouldShow) {
                        visibleCount++;
                    }
                });

                noResults.classList.toggle("d-none", visibleCount > 0);
            }

            // Kết nối các điều khiển tìm kiếm và lọc với hàm lọc danh sách.
            searchButton.addEventListener("click", filterRestaurants);
            searchInput.addEventListener("input", filterRestaurants);
            areaFilter.addEventListener("change", filterRestaurants);
            cuisineFilter.addEventListener("change", function () {
                updateCuisineButtons();
                filterRestaurants();
            });
            priceFilter.addEventListener("change", filterRestaurants);
            purposeFilter.addEventListener("change", filterRestaurants);

            cuisineButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const selected = button.dataset.cuisine;

                    cuisineFilter.value =
                        cuisineFilter.value === selected ? "" : selected;

                    updateCuisineButtons();
                    filterRestaurants();
                });
            });

            // Đổi trạng thái yêu thích trên giao diện.
            document.querySelectorAll(".favorite-button").forEach(function (button) {
                button.addEventListener("click", function () {
                    const isSaved = button.dataset.saved === "true";
                    button.dataset.saved = isSaved ? "false" : "true";
                    button.textContent = isSaved ? "♡ Yêu thích" : "♥ Đã lưu";
                    button.classList.toggle("btn-danger", !isSaved);
                    button.classList.toggle("btn-outline-danger", isSaved);
                });
            });

            // Lấy các thành phần của biểu mẫu đặt bàn ba bước.
            const bookingForm = document.getElementById("bookingForm");
            const bookingPanels = bookingForm.querySelectorAll("[data-step-panel]");
            const bookingIndicators = bookingForm.querySelectorAll("[data-step-indicator]");
            const bookingProgressFill = document.getElementById("bookingProgressFill");
            const bookingDate = document.getElementById("bookingDate");
            const bookingRestaurant = document.getElementById("bookingRestaurant");
            const bookingTime = document.getElementById("bookingTime");
            const customBookingTime = document.getElementById("customBookingTime");
            const bookingTimeError = document.getElementById("bookingTimeError");
            const bookingMessage = document.getElementById("bookingMessage");
            // Đổ tên các nhà hàng trên trang vào danh sách chọn đặt bàn.
            restaurantItems.forEach(function (item) {
                const nameElement = item.querySelector(".card-title");
                const metaElement = item.querySelector(".text-secondary.mb-2");

                if (!nameElement) return;

                const name = nameElement.textContent.trim();
                const option = document.createElement("option");

                option.value = name;
                option.textContent = metaElement
                    ? name + " — " + metaElement.textContent.trim()
                    : name;

                bookingRestaurant.appendChild(option);
            });
            let currentBookingStep = 1;

            // Không cho khách chọn ngày đặt bàn đã qua.
            const today = new Date();
            const localDate = new Date(
                today.getTime() - today.getTimezoneOffset() * 60000
            ).toISOString().split("T")[0];
            bookingDate.min = localDate;

            // Hiện bước hiện tại và cập nhật thanh tiến trình.
            function showBookingStep(step) {
                currentBookingStep = step;

                bookingPanels.forEach(function (panel) {
                    panel.classList.toggle("d-none", Number(panel.dataset.stepPanel) !== step);
                });

                bookingIndicators.forEach(function (indicator) {
                    const indicatorStep = Number(indicator.dataset.stepIndicator);
                    indicator.classList.toggle("is-active", indicatorStep === step);
                    indicator.classList.toggle("is-complete", indicatorStep < step);

                    if (indicatorStep === step) {
                        indicator.setAttribute("aria-current", "step");
                    } else {
                        indicator.removeAttribute("aria-current");
                    }
                });

                bookingProgressFill.style.width = ((step - 1) * 50) + "%";

                if (step === 3) {
                    updateBookingSummary();
                }
            }

            // Kiểm tra dữ liệu bắt buộc trước khi chuyển sang bước kế tiếp.
            function validateBookingStep(step) {
                const panel = bookingForm.querySelector('[data-step-panel="' + step + '"]');
                const requiredFields = panel.querySelectorAll("input[required], textarea[required], select[required]");

                for (const field of requiredFields) {
                    if (!field.checkValidity()) {
                        field.reportValidity();
                        return false;
                    }
                }

                if (step === 1) {
                    if (!bookingTime.value) {
                        bookingTimeError.classList.remove("d-none");
                        return false;
                    }

                    if (customBookingTime.value && !customBookingTime.checkValidity()) {
                        customBookingTime.reportValidity();
                        return false;
                    }
                }

                return true;
            }

            // Hiển thị thông tin khách đã nhập ở bước xác nhận.
            function updateBookingSummary() {
                const dateValue = bookingDate.value;
                const formattedDate = dateValue
                    ? new Date(dateValue + "T00:00:00").toLocaleDateString("vi-VN", {
                        weekday: "long", day: "2-digit", month: "2-digit", year: "numeric"
                    })
                    : "Chưa chọn";

                document.getElementById("summaryDate").textContent = formattedDate;
                document.getElementById("summaryRestaurant").textContent = bookingRestaurant.value || "Chưa chọn";
                document.getElementById("summaryTime").textContent = bookingTime.value || "Chưa chọn";
                document.getElementById("summaryGuests").textContent = document.getElementById("guestCount").value + " khách";
                document.getElementById("summaryName").textContent = document.getElementById("bookingName").value.trim();
                document.getElementById("summaryPhone").textContent = document.getElementById("bookingPhone").value.trim();
                document.getElementById("summarySpecial").textContent = document.getElementById("specialRequest").value.trim() || "Không có";
            }

            document.querySelectorAll(".booking-time-slot").forEach(function (button) {
                button.addEventListener("click", function () {
                    document.querySelectorAll(".booking-time-slot").forEach(function (option) {
                        option.classList.remove("is-selected");
                        option.setAttribute("aria-pressed", "false");
                    });

                    button.classList.add("is-selected");
                    button.setAttribute("aria-pressed", "true");
                    customBookingTime.value = "";
                    bookingTime.value = button.dataset.time;
                    bookingTimeError.classList.add("d-none");
                });
            });
            // Nếu khách tự nhập giờ, bỏ chọn giờ có sẵn và cập nhật giờ đặt.
            customBookingTime.addEventListener("input", function () {
                bookingTime.value = this.value;

                if (this.value) {
                    document.querySelectorAll(".booking-time-slot").forEach(function (button) {
                        button.classList.remove("is-selected");
                        button.setAttribute("aria-pressed", "false");
                    });

                    bookingTimeError.classList.add("d-none");
                }
            });
            // Xử lý nút Tiếp tục sau khi dữ liệu của bước hiện tại hợp lệ.
            bookingForm.querySelectorAll("[data-booking-next]").forEach(function (button) {
                button.addEventListener("click", function () {
                    if (validateBookingStep(currentBookingStep)) {
                        showBookingStep(Math.min(currentBookingStep + 1, 3));
                    }
                });
            });

            // Quay lại bước trước mà vẫn giữ thông tin đã nhập.
            bookingForm.querySelectorAll("[data-booking-back]").forEach(function (button) {
                button.addEventListener("click", function () {
                    showBookingStep(Math.max(currentBookingStep - 1, 1));
                });
            });
            // Xóa thông tin đặt bàn và đưa biểu mẫu về bước đầu.
            document.getElementById("restartBooking")
                .addEventListener("click", function () {
                    bookingForm.reset();
                    bookingTime.value = "";
                    bookingTimeError.classList.add("d-none");
                    bookingMessage.classList.add("d-none");

                    document.querySelectorAll(".booking-time-slot").forEach(function (button) {
                        button.classList.remove("is-selected");
                        button.setAttribute("aria-pressed", "false");
                    });

                    document.getElementById("confirmBooking").disabled = false;

                    [
                        "summaryRestaurant",
                        "summaryDate",
                        "summaryTime",
                        "summaryGuests",
                        "summaryName",
                        "summaryPhone",
                        "summarySpecial"
                    ].forEach(function (id) {
                        document.getElementById(id).textContent = "";
                    });

                    showBookingStep(1);

                    document.getElementById("dat-ban").scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                });

            // Đây là xác nhận mẫu trên giao diện; hiện chưa lưu vào cơ sở dữ liệu.
            bookingForm.addEventListener("submit", function (event) {
                event.preventDefault();

                if (currentBookingStep !== 3) {
                    return;
                }

                bookingMessage.classList.remove("d-none");
                bookingMessage.scrollIntoView({ behavior: "smooth", block: "nearest" });
                document.getElementById("confirmBooking").disabled = true;
            });
        })();
    </script>
}
