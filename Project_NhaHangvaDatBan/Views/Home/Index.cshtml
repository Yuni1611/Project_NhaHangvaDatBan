                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="guestCount">Số lượng khách</label>
                                    <input class="form-control" id="guestCount" type="number" min="1" max="30" value="2" required />
                                </div>
                            </div>

                            <div class="booking-step-actions justify-content-end">
                                <button class="btn btn-food" type="button" data-booking-next>Tiếp tục <span aria-hidden="true">→</span></button>
                            </div>
                        </div>

                <div class="booking-step-panel d-none" data-step-panel="2">
                    <h3>Cho nhà hàng biết cách liên hệ với bạn</h3>
                    <div class="mb-3">
                        <label class="form-label" for="bookingName">Tên của bạn</label>
                        <input class="form-control" id="bookingName" type="text" autocomplete="name" placeholder="Nhập tên của bạn" required />
