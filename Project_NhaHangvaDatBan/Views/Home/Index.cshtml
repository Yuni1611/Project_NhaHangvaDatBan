            <button class="cuisine-chip" type="button" data-cuisine="Quán nhậu" aria-pressed="false">
                <span class="cuisine-icon">🍻</span><span>Quán nhậu</span>
            </button>
            <button class="cuisine-chip" type="button" data-cuisine="Món Nhật" aria-pressed="false">
                <span class="cuisine-icon">🍣</span><span>Món Nhật</span>
            </button>
            <button class="cuisine-chip" type="button" data-cuisine="Món Việt" aria-pressed="false">
                <span class="cuisine-icon">🍜</span><span>Món Việt</span>
            </button>
            <button class="cuisine-chip" type="button" data-cuisine="Món Hàn" aria-pressed="false">
                <span class="cuisine-icon">🥘</span><span>Món Hàn</span>
            </button>
            <button class="cuisine-chip" type="button" data-cuisine="Món Âu" aria-pressed="false">
                <span class="cuisine-icon">🍝</span><span>Món Âu</span>
            </button>
            <button class="cuisine-chip" type="button" data-cuisine="Món Hoa" aria-pressed="false">
                <span class="cuisine-icon">🥟</span><span>Món Hoa</span>
            </button>
            <button class="cuisine-chip" type="button" data-cuisine="Món chay" aria-pressed="false">
                <span class="cuisine-icon">🥬</span><span>Món chay</span>
            </button>
        </div>
    </div>

