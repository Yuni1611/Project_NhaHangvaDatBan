@* Khu vực hiển thị ảnh, thông tin, món ăn và bản đồ của nhà hàng được chọn. *@
<section id="chi-tiet"
         class="mt-4 d-none"
         aria-live="polite"
         aria-label="Thông tin nhà hàng được chọn">
    <div class="booking-panel">
        <div class="ft-detail-grid">
            <div class="ft-main-photo-box">
                @* Cột ảnh nhà hàng và giá tham khảo. *@
                <img id="detailImage" src="" alt="" />
                <div class="ft-price-caption">
                    Giá tham khảo: <strong id="detailPrice"></strong>
                </div>
            </div>

            <div>
                @* Cột thông tin: tên, đánh giá, dịp phù hợp, món ăn và mô tả. *@
                <h2 id="detailName" class="h4 mb-1"></h2>
                <p id="detailMeta" class="text-secondary mb-1"></p>
                <p id="detailRating" class="restaurant-rating mb-2"></p>

                <div id="detailTags" class="mb-2"></div>

                <div class="small fw-semibold" style="color: #30231d;">Món ăn đặc trưng</div>
                <div id="detailDishes" class="ft-featured-dishes"></div>

                <p id="detailDescription" class="mb-2"></p>
                <div class="small text-secondary">
                    <strong>Phù hợp:</strong>
                    <span id="detailPurpose"></span>
                </div>
            </div>

            @* Cột bản đồ và công cụ ghim địa chỉ. *@
            <div class="ft-map-column">
                <div class="ft-map-top-bar">
                    <button id="closeDetail" class="btn btn-sm btn-outline-secondary" type="button">Đóng</button>
                </div>

                <div class="ft-map-box">
                    <div class="ft-map-search-row">
                        <input type="text" id="mapPinInput" placeholder="Tìm / ghim địa chỉ hoặc tọa độ" />
                        <button type="button" id="btnPinMap" class="btn btn-sm btn-food">Ghim</button>
                    </div>
                    <div class="ft-map-frame">
                        <iframe id="detailMapIframe"
                                style="width:100%; height:100%; border:0;"
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                src="https://maps.google.com/maps?q=TP.HCM&hl=vi&z=15&output=embed"></iframe>
                    </div>
                    <div id="detailMapAddress" class="ft-map-address"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@* Biểu mẫu đặt bàn chia thành ba bước. *@
<section id="dat-ban" class="mt-5">
    <div class="booking-experience">
        @* Ảnh giới thiệu tạo điểm nhấn cho biểu mẫu đặt bàn. *@
        <aside class="booking-visual">
            <img src="@Url.Content("~/Content/IMG/Hero/restaurant-1.png")" alt="Không gian ấm cúng của nhà hàng" />
            <div class="booking-visual-copy">
                <div class="small text-uppercase fw-bold mb-2">FoodTable · Đặt bàn dễ dàng</div>
                <h3>Một chỗ ngồi đẹp, một buổi tối đáng nhớ.</h3>
                <p class="mb-0">Chọn thời gian phù hợp, để nhà hàng chuẩn bị đón bạn.</p>
            </div>
        </aside>

        <div class="booking-content">
            <div class="booking-brand"><span aria-hidden="true">♨</span> FoodTable</div>
            <h2 class="booking-heading">Đặt bàn tại nhà hàng</h2>

            <div id="bookingMessage" class="alert alert-danger d-none" role="alert"></div>

            <form id="bookingForm" novalidate data-save-url="@Url.Action("SaveBooking", "Home")">
                @Html.AntiForgeryToken()
                @* Thanh báo khách đang ở bước nào trong quy trình. *@
                <div class="booking-stepper" aria-label="Các bước đặt bàn">
                    <div class="booking-step-track"><span id="bookingProgressFill" class="booking-step-track-fill"></span></div>
                    <ol class="booking-step-list">
                        <li class="booking-step-indicator is-active" data-step-indicator="1" aria-current="step">
                            <span class="booking-step-dot">1</span><span>Chọn thời gian</span>
                        </li>
                        <li class="booking-step-indicator" data-step-indicator="2">
                            <span class="booking-step-dot">2</span><span>Thông tin liên hệ</span>
                        </li>
                        <li class="booking-step-indicator" data-step-indicator="3">
                            <span class="booking-step-dot">3</span><span>Xác nhận</span>
                        </li>
                    </ol>
                </div>

                @* Bước 1: chọn nhà hàng, ngày, giờ và số lượng khách. *@
                <div class="booking-step-panel" data-step-panel="1">
                    <h3>Chọn ngày và giờ bạn muốn đến</h3>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="bookingRestaurant">Nhà hàng</label>
                            <select class="form-select" id="bookingRestaurant" required>
                                <option value="">-- Chọn nhà hàng --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="bookingDate">Ngày đặt</label>
                            <input class="form-control" id="bookingDate" type="date" required />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 mb-3">
                            <div class="form-label">Giờ đặt</div>
                            <input id="bookingTime" name="bookingTime" type="hidden" />

                            <div class="booking-time-grid" id="bookingTimeChoices">
                                <button class="booking-time-slot" type="button" data-time="11:00">11:00</button>
                                <button class="booking-time-slot" type="button" data-time="11:30">11:30</button>
                                <button class="booking-time-slot" type="button" data-time="12:00">12:00</button>
                                <button class="booking-time-slot" type="button" data-time="12:30">12:30</button>
                                <button class="booking-time-slot" type="button" data-time="18:00">18:00</button>
                                <button class="booking-time-slot" type="button" data-time="18:30">18:30</button>
                                <button class="booking-time-slot" type="button" data-time="19:00">19:00</button>
                                <button class="booking-time-slot" type="button" data-time="19:30">19:30</button>
                            </div>
                            <div id="bookingTimeError" class="small text-danger mt-2 d-none">
                                Bạn hãy chọn hoặc nhập giờ đặt bàn.
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-md-6 mb-3">
                            <label class="form-label mt-3" for="customBookingTime">Hoặc tự chọn giờ</label>
                            <input class="form-control" id="customBookingTime" type="time" min="10:00" max="22:00" step="1800" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="guestCount">Số lượng khách</label>
                            <input class="form-control" id="guestCount" type="number" min="1" max="30" value="2" required />
                        </div>
                    </div>

                    <div class="booking-step-actions justify-content-end">
                        <button class="btn btn-food" type="button" data-booking-next>Tiếp tục <span aria-hidden="true">→</span></button>
                    </div>
                </div>

                @* Bước 2: nhập thông tin liên hệ và yêu cầu đặc biệt. *@
                <div class="booking-step-panel d-none" data-step-panel="2">
                    <h3>Cho nhà hàng biết cách liên hệ với bạn</h3>
                    <div class="mb-3">
                        <label class="form-label" for="bookingName">Tên của bạn</label>
                        <input class="form-control" id="bookingName" type="text" autocomplete="name" placeholder="Nhập tên của bạn" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bookingPhone">Số điện thoại</label>
                        <input class="form-control"
                               id="bookingPhone"
                               type="tel"
                               inputmode="numeric"
                               pattern="0[0-9]{9}"
                               minlength="10"
                               maxlength="10"
                               title="Số điện thoại phải có 10 chữ số và bắt đầu bằng số 0"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)"
                               autocomplete="tel"
                               placeholder="Nhập số điện thoại, ví dụ 0912345678"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="specialRequest">Yêu cầu đặc biệt <span class="text-secondary fw-normal">(không bắt buộc)</span></label>
                        <textarea class="form-control" id="specialRequest" rows="3" placeholder="Ví dụ: bàn gần cửa sổ, dịp sinh nhật..."></textarea>
                    </div>
                    <div class="booking-step-actions">
                        <button class="btn btn-outline-secondary" type="button" data-booking-back>Quay lại</button>
                        <button class="btn btn-food" type="button" data-booking-next>Tiếp tục <span aria-hidden="true">→</span></button>
                    </div>
                </div>

                @* Bước 3: kiểm tra lại thông tin và xác nhận đặt bàn. *@
                <div class="booking-step-panel d-none" data-step-panel="3">
                    <div id="bookingReviewBox">
                        <h3>Kiểm tra lại thông tin đặt bàn</h3>

                        <div class="booking-summary">
                            <div class="booking-summary-row"><span>Nhà hàng</span><span id="summaryRestaurant"></span></div>
                            <div class="booking-summary-row"><span>Ngày đặt</span><span id="summaryDate"></span></div>
                            <div class="booking-summary-row"><span>Giờ đặt</span><span id="summaryTime"></span></div>
                            <div class="booking-summary-row"><span>Số lượng khách</span><span id="summaryGuests"></span></div>
                            <div class="booking-summary-row"><span>Tên của bạn</span><span id="summaryName"></span></div>
                            <div class="booking-summary-row"><span>Số điện thoại</span><span id="summaryPhone"></span></div>
                            <div class="booking-summary-row"><span>Yêu cầu đặc biệt</span><span id="summarySpecial"></span></div>
                        </div>

                        <div class="booking-step-actions flex-wrap">
                            <button class="btn btn-outline-danger" id="restartBooking" type="button">Quay lại từ đầu</button>
                            <button class="btn btn-food" id="confirmBooking" type="submit">Xác nhận đặt bàn</button>
                        </div>
                    </div>

                    @* Thông báo mẫu sau khi khách xác nhận đặt bàn. *@
                    <div id="bookingSuccessPanel" class="booking-success-card d-none" role="status" aria-live="polite">
                        <div class="booking-success-badge" aria-hidden="true">✓</div>
                        <h3 class="mb-2">Đặt bàn thành công!</h3>
                        <div id="successBookingCode" class="booking-code-pill">Mã đặt bàn: #FT0000</div>
                        <p class="small text-secondary mb-3">
                            Yêu cầu đặt bàn của bạn đã được ghi nhận với trạng thái <strong>Chờ xác nhận</strong>.
                        </p>

                        <div class="booking-summary text-start mb-3">
                            <div class="booking-summary-row"><span>Nhà hàng</span><span id="successRestaurant"></span></div>
                            <div class="booking-summary-row"><span>Ngày đặt</span><span id="successDate"></span></div>
                            <div class="booking-summary-row"><span>Giờ đặt</span><span id="successTime"></span></div>
                            <div class="booking-summary-row"><span>Số lượng khách</span><span id="successGuests"></span></div>
                            <div class="booking-summary-row"><span>Tên của bạn</span><span id="successName"></span></div>
                            <div class="booking-summary-row"><span>Số điện thoại</span><span id="successPhone"></span></div>
                            <div class="booking-summary-row"><span>Yêu cầu đặc biệt</span><span id="successSpecial"></span></div>
                            <div class="booking-summary-row"><span>Trạng thái</span><span>Chờ xác nhận</span></div>
                        </div>

                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <button class="btn btn-food" id="newBookingBtn" type="button">Đặt bàn mới</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

