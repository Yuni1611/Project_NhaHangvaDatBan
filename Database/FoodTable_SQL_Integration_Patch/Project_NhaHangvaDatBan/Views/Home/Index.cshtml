                "hai-san-ben-gio": {
                    tags: ["Ăn gia đình", "Sinh nhật", "Tiếp khách"],
                    address: "48 Kha Vạn Cân, Phường Hiệp Bình Chánh, TP. Thủ Đức, TP.HCM",
                    mapQuery: "48 Kha Vạn Cân, TP. Thủ Đức, TP. Hồ Chí Minh",
                    dishes: [
                        { name: "Tôm sú nướng muối ớt xanh", price: "240.000đ", img: "https://images.unsplash.com/photo-1559737558-2bf22b72f2fb?auto=format&fit=crop&w=400&q=80" },
                        { name: "Cua biển rang me chua ngọt", price: "390.000đ", img: "https://images.unsplash.com/photo-1565680018434-b513d5e5fd47?auto=format&fit=crop&w=400&q=80" },
                        { name: "Hàu sữa nướng phô mai", price: "130.000đ", img: "https://images.unsplash.com/photo-1535140728325-a4d3707eee61?auto=format&fit=crop&w=400&q=80" }
                    ]
                },
                "lau-moc-garden": {
                    tags: ["Ăn gia đình", "Họp nhóm", "Sinh nhật"],
                    address: "86 Nguyễn Gia Trí, Phường 25, Quận Bình Thạnh, TP.HCM",
                    mapQuery: "86 Nguyễn Gia Trí, Quận Bình Thạnh, TP. Hồ Chí Minh",
                    dishes: [
                        { name: "Lẩu nấm thiên nhiên thanh ngọt", price: "290.000đ", img: "https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=400&q=80" },
                        { name: "Nấm đùi gà áp chảo bơ tỏi", price: "95.000đ", img: "https://images.unsplash.com/photo-1504544750208-dc0358e63f7f?auto=format&fit=crop&w=400&q=80" },
                        { name: "Rau xanh vườn trồng theo mùa", price: "65.000đ", img: "https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=400&q=80" }
                    ]
                }
            };

            // Lấy các ô tìm kiếm, bộ lọc, danh sách nhà hàng và khung chi tiết.
            const searchInput = document.getElementById("searchInput");
            const searchButton = document.getElementById("searchButton");
            const areaFilter = document.getElementById("areaFilter");
            const cuisineFilter = document.getElementById("cuisineFilter");
            const priceFilter = document.getElementById("priceFilter");
            const purposeFilter = document.getElementById("purposeFilter");
            const restaurantItems = document.querySelectorAll(".restaurant-item");
            const noResults = document.getElementById("noResults");
            const cuisineButtons = document.querySelectorAll(".cuisine-chip");
            const detailSection = document.getElementById("chi-tiet");
            const detailImage = document.getElementById("detailImage");
            const mapPinInput = document.getElementById("mapPinInput");
            const detailMapIframe = document.getElementById("detailMapIframe");
            const detailMapAddress = document.getElementById("detailMapAddress");

            // Đổi vị trí bản đồ và dòng địa chỉ hiển thị bên dưới.
            function setMapLocation(query, addressLabel) {
                if (detailMapIframe) {
                    detailMapIframe.src = "https://maps.google.com/maps?q=" + encodeURIComponent(query) + "&hl=vi&z=15&output=embed";
                }
                if (detailMapAddress) {
                    detailMapAddress.textContent = addressLabel || query;
                }
            }

            // Mở thông tin chi tiết của đúng nhà hàng được bấm.
            document.getElementById("restaurantList")
                .addEventListener("click", function (event) {
                    const target = event.target instanceof Element ? event.target : null;
                    const detailLink = target ? target.closest('a[href="#chi-tiet"]') : null;

                    if (!detailLink) {
                        return;
                    }

                    event.preventDefault();

                    const restaurant = detailLink.closest(".restaurant-item");
                    if (!restaurant) return;

                    const restId = restaurant.dataset.id || "";
                    const extra = restaurantExtraData[restId] || {
                        tags: (restaurant.dataset.purpose || "").split("|").filter(Boolean),
                        address: restaurant.dataset.area || "TP. Hồ Chí Minh",
                        mapQuery: restaurant.dataset.area || "TP. Hồ Chí Minh",
                        dishes: []
                    };

                    const titleEl = restaurant.querySelector(".card-title");
                    const name = titleEl && titleEl.textContent ? titleEl.textContent.trim() : "";
                    const image = restaurant.querySelector(".card-img-top");
                    const meta = restaurant.querySelector(".text-secondary.mb-2");
                    const rating = restaurant.querySelector(".restaurant-rating");
                    const description = restaurant.querySelector(".card-text");
                    const price = Number(restaurant.dataset.price || 0);
                    const purposes = (restaurant.dataset.purpose || "").split("|").join(" · ");

                    if (detailImage && image) {
                        detailImage.setAttribute("src", image.getAttribute("src") || "");
                        detailImage.setAttribute("alt", "Ảnh nhà hàng " + name);
                    }

                    const nameEl = document.getElementById("detailName");
                    if (nameEl) nameEl.textContent = name;

                    const metaEl = document.getElementById("detailMeta");
                    if (metaEl) metaEl.textContent = meta && meta.textContent ? meta.textContent.trim() : "";

                    const ratingEl = document.getElementById("detailRating");
                    if (ratingEl) ratingEl.textContent = rating && rating.textContent ? rating.textContent.trim().replace(/\s+/g, " ") : "";

                    const descEl = document.getElementById("detailDescription");
                    if (descEl) descEl.textContent = description && description.textContent ? description.textContent.trim() : "";

                    const priceEl = document.getElementById("detailPrice");
                    if (priceEl) priceEl.textContent = price ? (price * 1000).toLocaleString("vi-VN") + "đ/người" : "Chưa cập nhật";

                    const purposeEl = document.getElementById("detailPurpose");
                    if (purposeEl) purposeEl.textContent = purposes || "Chưa cập nhật";

                    const tagsEl = document.getElementById("detailTags");
                    if (tagsEl) {
                        tagsEl.innerHTML = (extra.tags || []).map(function (t) {
                            return '<span class="ft-tag-pill">' + t + '</span>';
                        }).join("");
                    }

                    const dishesEl = document.getElementById("detailDishes");
                    if (dishesEl) {
                        dishesEl.innerHTML = (extra.dishes || []).slice(0, 3).map(function (d) {
                            return '<div class="ft-dish-card">' +
                                '<img src="' + d.img + '" alt="' + d.name + '" />' +
                                '<div class="ft-dish-name">' + d.name + '</div>' +
                                '<div class="ft-dish-price">' + d.price + '</div>' +
                                '</div>';
                        }).join("");
                    }

                    if (mapPinInput) {
                        mapPinInput.value = extra.mapQuery;
                    }
                    setMapLocation(extra.mapQuery, extra.address);

                    if (detailSection) {
                        detailSection.classList.remove("d-none");
                        detailSection.scrollIntoView({
                            behavior: "smooth",
                            block: "nearest"
                        });
                    }
                });

            // Cập nhật vị trí ghim trên bản đồ theo địa chỉ vừa nhập.
            document.getElementById("btnPinMap")
                .addEventListener("click", function () {
                    if (!mapPinInput) return;
                    const q = mapPinInput.value.trim();
                    if (!q) {
                        alert("Vui lòng nhập địa chỉ hoặc tọa độ để ghim vị trí Google Map.");
                        return;
                    }
                    setMapLocation(q, q);
                });

            // Ẩn khung thông tin chi tiết nhà hàng.
            document.getElementById("closeDetail")
                .addEventListener("click", function () {
                    if (detailSection) {
                        detailSection.classList.add("d-none");
                    }
                });

            // Kiểm tra giá nhà hàng có nằm trong khoảng giá đang chọn không.
            function priceMatches(price, range) {
                if (range === "") return true;
                if (range.endsWith("+")) return price >= Number(range.slice(0, -1));
                const parts = range.split("-");
                return price >= Number(parts[0]) && price < Number(parts[1]);
            }

            // Đồng bộ trạng thái sáng/tắt của các biểu tượng ẩm thực.
            function updateCuisineButtons() {
                cuisineButtons.forEach(function (button) {
                    const isSelected = button.dataset.cuisine === cuisineFilter.value;
                    button.classList.toggle("active", isSelected);
                    button.setAttribute("aria-pressed", isSelected);
                });
            }

            // Hiển thị những nhà hàng phù hợp với toàn bộ tiêu chí đã chọn.
            function filterRestaurants() {
                const searchText = searchInput.value.trim().toLowerCase();
                const selectedArea = areaFilter.value;
                const selectedCuisine = cuisineFilter.value;
                const selectedPrice = priceFilter.value;
                const selectedPurpose = purposeFilter.value;
                let visibleCount = 0;

                restaurantItems.forEach(function (item) {
                    const matchesText = item.textContent.toLowerCase().includes(searchText);
                    const matchesArea = selectedArea === "" || item.dataset.area === selectedArea;
                    const matchesCuisine = selectedCuisine === "" || item.dataset.cuisine === selectedCuisine;
                    const itemPrice = Number(item.dataset.price || 0);
                    const matchesPrice = priceMatches(itemPrice, selectedPrice);
                    const itemPurposes = (item.dataset.purpose || "").split("|");
                    const matchesPurpose = selectedPurpose === "" || itemPurposes.includes(selectedPurpose);
                    const shouldShow = matchesText && matchesArea && matchesCuisine && matchesPrice && matchesPurpose;

                    item.classList.toggle("d-none", !shouldShow);
                    if (shouldShow) visibleCount++;
                });

                noResults.classList.toggle("d-none", visibleCount > 0);
            }

            searchButton.addEventListener("click", filterRestaurants);
            searchInput.addEventListener("input", filterRestaurants);
            areaFilter.addEventListener("change", filterRestaurants);
            cuisineFilter.addEventListener("change", function () {
                updateCuisineButtons();
                filterRestaurants();
            });
            priceFilter.addEventListener("change", filterRestaurants);
            purposeFilter.addEventListener("change", filterRestaurants);

            cuisineButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const selected = button.dataset.cuisine;
                    cuisineFilter.value = cuisineFilter.value === selected ? "" : selected;
                    updateCuisineButtons();
                    filterRestaurants();
                });
            });

            // Đổi trạng thái nút Yêu thích khi khách bấm.
            document.querySelectorAll(".favorite-button").forEach(function (button) {
                button.addEventListener("click", function () {
                    const isSaved = button.dataset.saved === "true";
                    button.dataset.saved = isSaved ? "false" : "true";
                    button.textContent = isSaved ? "♡ Yêu thích" : "♥ Đã lưu";
                    button.classList.toggle("btn-danger", !isSaved);
                    button.classList.toggle("btn-outline-danger", isSaved);
                });
            });

            // Lấy các trường và thành phần điều khiển quy trình đặt bàn.
            const bookingForm = document.getElementById("bookingForm");
            const bookingPanels = bookingForm.querySelectorAll("[data-step-panel]");
            const bookingIndicators = bookingForm.querySelectorAll("[data-step-indicator]");
            const bookingProgressFill = document.getElementById("bookingProgressFill");
            const bookingDate = document.getElementById("bookingDate");
            const bookingRestaurant = document.getElementById("bookingRestaurant");
            const bookingTime = document.getElementById("bookingTime");
            const customBookingTime = document.getElementById("customBookingTime");
            const bookingTimeError = document.getElementById("bookingTimeError");
            const bookingMessage = document.getElementById("bookingMessage");

            restaurantItems.forEach(function (item) {
                const nameElement = item.querySelector(".card-title");
                const metaElement = item.querySelector(".text-secondary.mb-2");
                if (!nameElement) return;

                const name = nameElement.textContent.trim();
                const option = document.createElement("option");
                option.value = name;
                option.textContent = metaElement ? name + " — " + metaElement.textContent.trim() : name;
                bookingRestaurant.appendChild(option);
            });

            // Khởi tạo ở bước 1 và chặn việc chọn ngày trong quá khứ.
            let currentBookingStep = 1;

            const today = new Date();
            const localDate = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().split("T")[0];
            bookingDate.min = localDate;

            // Chuyển bước, cập nhật thanh tiến trình và làm mới phần xem lại.
            function showBookingStep(step) {
                currentBookingStep = step;

                bookingPanels.forEach(function (panel) {
                    panel.classList.toggle("d-none", Number(panel.dataset.stepPanel) !== step);
                });

                bookingIndicators.forEach(function (indicator) {
                    const indicatorStep = Number(indicator.dataset.stepIndicator);
                    indicator.classList.toggle("is-active", indicatorStep === step);
                    indicator.classList.toggle("is-complete", indicatorStep < step);

                    if (indicatorStep === step) {
                        indicator.setAttribute("aria-current", "step");
                    } else {
                        indicator.removeAttribute("aria-current");
                    }
                });

                bookingProgressFill.style.width = ((step - 1) * 50) + "%";

                if (step === 3) {
                    updateBookingSummary();
                }
            }

            // Kiểm tra các ô bắt buộc trước khi cho khách sang bước tiếp theo.
            function validateBookingStep(step) {
                const panel = bookingForm.querySelector('[data-step-panel="' + step + '"]');
                const requiredFields = panel.querySelectorAll("input[required], textarea[required], select[required]");

                for (const field of requiredFields) {
                    if (!field.checkValidity()) {
                        field.reportValidity();
                        return false;
                    }
                }

                if (step === 1) {
                    if (!bookingTime.value) {
                        bookingTimeError.classList.remove("d-none");
                        return false;
                    }

                    if (customBookingTime.value && !customBookingTime.checkValidity()) {
                        customBookingTime.reportValidity();
                        return false;
                    }
                }

                return true;
            }

            // Chép thông tin đã nhập sang trang xác nhận.
            function updateBookingSummary() {
                const dateValue = bookingDate.value;
                const formattedDate = dateValue
                    ? new Date(dateValue + "T00:00:00").toLocaleDateString("vi-VN", {
                        weekday: "long", day: "2-digit", month: "2-digit", year: "numeric"
                    })
                    : "Chưa chọn";

                document.getElementById("summaryDate").textContent = formattedDate;
                document.getElementById("summaryRestaurant").textContent = bookingRestaurant.value || "Chưa chọn";
                document.getElementById("summaryTime").textContent = bookingTime.value || "Chưa chọn";
                document.getElementById("summaryGuests").textContent = document.getElementById("guestCount").value + " khách";
                document.getElementById("summaryName").textContent = document.getElementById("bookingName").value.trim();
                document.getElementById("summaryPhone").textContent = document.getElementById("bookingPhone").value.trim();
                document.getElementById("summarySpecial").textContent = document.getElementById("specialRequest").value.trim() || "Không có";
            }

            // Chọn một khung giờ nhanh và đồng bộ vào ô giờ ẩn.
            document.querySelectorAll(".booking-time-slot").forEach(function (button) {
                button.addEventListener("click", function () {
                    document.querySelectorAll(".booking-time-slot").forEach(function (option) {
                        option.classList.remove("is-selected");
                        option.setAttribute("aria-pressed", "false");
                    });

                    button.classList.add("is-selected");
                    button.setAttribute("aria-pressed", "true");
                    customBookingTime.value = "";
                    bookingTime.value = button.dataset.time;
                    bookingTimeError.classList.add("d-none");
                });
            });

            // Nếu khách tự nhập giờ, bỏ chọn nút giờ nhanh trước đó.
            customBookingTime.addEventListener("input", function () {
                bookingTime.value = this.value;

                if (this.value) {
                    document.querySelectorAll(".booking-time-slot").forEach(function (button) {
                        button.classList.remove("is-selected");
                        button.setAttribute("aria-pressed", "false");
                    });

                    bookingTimeError.classList.add("d-none");
                }
            });

            // Xử lý nút Tiếp tục và kiểm tra dữ liệu của bước hiện tại.
            bookingForm.querySelectorAll("[data-booking-next]").forEach(function (button) {
                button.addEventListener("click", function () {
                    if (validateBookingStep(currentBookingStep)) {
                        showBookingStep(Math.min(currentBookingStep + 1, 3));
                    }
                });
            });

            // Xử lý các nút quay lại bước trước.
            bookingForm.querySelectorAll("[data-booking-back]").forEach(function (button) {
                button.addEventListener("click", function () {
                    showBookingStep(Math.max(currentBookingStep - 1, 1));
                });
            });

            const bookingReviewBox = document.getElementById("bookingReviewBox");
            const bookingSuccessPanel = document.getElementById("bookingSuccessPanel");

            // Xóa dữ liệu đã nhập và đưa biểu mẫu về trạng thái ban đầu.
            function resetBookingFormState() {
                bookingForm.reset();
                bookingTime.value = "";
                bookingTimeError.classList.add("d-none");
                bookingMessage.textContent = "";
                bookingMessage.classList.add("d-none");
                if (bookingReviewBox) {
                    bookingReviewBox.classList.remove("d-none");
                }
                if (bookingSuccessPanel) {
                    bookingSuccessPanel.classList.add("d-none");
                }

                document.querySelectorAll(".booking-time-slot").forEach(function (button) {
                    button.classList.remove("is-selected");
                    button.setAttribute("aria-pressed", "false");
                });

                document.getElementById("confirmBooking").disabled = false;

                [
                    "summaryRestaurant",
                    "summaryDate",
                    "summaryTime",
                    "summaryGuests",
                    "summaryName",
                    "summaryPhone",
                    "summarySpecial",
                    "successRestaurant",
                    "successDate",
                    "successTime",
                    "successGuests",
                    "successName",
                    "successPhone",
                    "successSpecial"
                ].forEach(function (id) {
                    const el = document.getElementById(id);
                    if (el) el.textContent = "";
                });

                showBookingStep(1);
            }

            // Bắt đầu lại từ đầu ở màn hình xem lại thông tin.
            document.getElementById("restartBooking")
                .addEventListener("click", function () {
                    resetBookingFormState();
                    document.getElementById("dat-ban").scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                });

            // Tạo lượt đặt bàn mới sau thông báo thành công.
            document.getElementById("newBookingBtn")
                .addEventListener("click", function () {
                    resetBookingFormState();
                    document.getElementById("dat-ban").scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                });

            // Xác nhận giao diện mẫu; đoạn này chưa lưu dữ liệu vào cơ sở dữ liệu.
            bookingForm.addEventListener("submit", function (event) {
                event.preventDefault();

                if (currentBookingStep !== 3) {
                    return;
                }

                const confirmButton = document.getElementById("confirmBooking");
                const tokenInput = bookingForm.querySelector('input[name="__RequestVerificationToken"]');
                const formData = new URLSearchParams();

                formData.append("__RequestVerificationToken", tokenInput ? tokenInput.value : "");
                formData.append("restaurantName", bookingRestaurant.value);
                formData.append("bookingDate", bookingDate.value);
                formData.append("bookingTime", bookingTime.value);
                formData.append("guestCount", document.getElementById("guestCount").value);
                formData.append("bookingName", document.getElementById("bookingName").value.trim());
                formData.append("bookingPhone", document.getElementById("bookingPhone").value.trim());
                formData.append("specialRequest", document.getElementById("specialRequest").value.trim());

                bookingMessage.textContent = "";
                bookingMessage.classList.add("d-none");
                confirmButton.disabled = true;

                fetch(bookingForm.dataset.saveUrl, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                    },
                    body: formData.toString()
                })
                    .then(function (response) {
                        return response.json().then(function (result) {
                            if (!response.ok || !result.success) {
                                const error = new Error(result.message || "Chưa lưu được yêu cầu đặt bàn.");
                                error.isServerMessage = true;
                                throw error;
                            }
                            return result;
                        });
                    })
                    .then(function (result) {
                        const codeEl = document.getElementById("successBookingCode");
                        if (codeEl) {
                            codeEl.textContent = "Mã đặt bàn: #" + result.code;
                        }

                        document.getElementById("successRestaurant").textContent =
                            document.getElementById("summaryRestaurant").textContent;
                        document.getElementById("successDate").textContent =
                            document.getElementById("summaryDate").textContent;
                        document.getElementById("successTime").textContent =
                            document.getElementById("summaryTime").textContent;
                        document.getElementById("successGuests").textContent =
                            document.getElementById("summaryGuests").textContent;
                        document.getElementById("successName").textContent =
                            document.getElementById("summaryName").textContent;
                        document.getElementById("successPhone").textContent =
                            document.getElementById("summaryPhone").textContent;
                        document.getElementById("successSpecial").textContent =
                            document.getElementById("summarySpecial").textContent;

                        if (bookingReviewBox) {
                            bookingReviewBox.classList.add("d-none");
                        }
                        if (bookingSuccessPanel) {
                            bookingSuccessPanel.classList.remove("d-none");
                            bookingSuccessPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
                        }
                    })
                    .catch(function (error) {
                        bookingMessage.textContent = error.isServerMessage
                            ? error.message
                            : "Không kết nối được với máy chủ. Hãy kiểm tra SQL Server và thử lại.";
                        bookingMessage.classList.remove("d-none");
                        confirmButton.disabled = false;
                    });
            });        })();
    </script>
}