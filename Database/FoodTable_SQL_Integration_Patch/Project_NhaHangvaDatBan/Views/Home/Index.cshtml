@{
    ViewBag.Title = "Khám phá nhà hàng";
}

<style>
    /* Banner trình chiếu lớn ở đầu trang */
    .hero-carousel {
        position: relative;
        height: 500px;
        overflow: hidden;
        border-radius: 1rem;
        background-color: #24160f;
    }

    .hero-carousel-slides {
        position: absolute;
        inset: 0;
        height: 100%;
    }

    .hero-carousel .carousel-inner,
    .hero-carousel .carousel-item {
        height: 100%;
    }

        .hero-carousel .carousel-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .hero-shade {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient( 90deg, rgba(20, 12, 8, .82), rgba(20, 12, 8, .35) );
    }

    .hero-content {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        z-index: 3;
        padding: 2rem 2.5rem;
        color: #fff;
        transform: translateY(-50%);
    }

        .hero-content h1 {
            max-width: 700px;
            font-family: Georgia, serif;
            font-size: clamp(2.2rem, 5vw, 4rem);
            font-weight: 700;
        }

        .hero-content p {
            max-width: 700px;
            color: #f6e8de;
            font-size: 1.1rem;
        }

    .hero-search {
        max-width: 850px;
    }

    .hero-carousel .carousel-control-prev,
    .hero-carousel .carousel-control-next,
    .hero-carousel .carousel-indicators {
        z-index: 4;
    }

    @@media (max-width: 576px) {
        .hero-carousel {
            height: 540px;
        }

        .hero-content {
            padding: 1.5rem;
        }
    }

    /* Tiêu đề, thẻ thông tin và nút thao tác trên nhà hàng */
    .section-title {
        margin: 2rem 0 1rem;
        color: #43271b;
        font-family: Georgia, serif;
        font-weight: 700;
    }

    .restaurant-card {
        height: 100%;
        overflow: hidden;
        border: 1px solid #eadbcf;
        border-radius: 1rem;
        box-shadow: 0 5px 18px rgba(74, 43, 25, .08);
        transition: transform .2s, box-shadow .2s;
    }

        .restaurant-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(74, 43, 25, .15);
        }

        .restaurant-card .card-img-top {
            height: 210px;
            object-fit: cover;
        }

        .restaurant-card .card-title {
            color: #35231a;
            font-weight: 700;
        }

    .restaurant-rating {
        color: #d88b00;
        font-weight: 700;
    }

    .btn-food {
        color: #fff;
        background-color: #a94321;
        border-color: #a94321;
    }

        .btn-food:hover {
            color: #fff;
            background-color: #873317;
            border-color: #873317;
        }

    /* Khung trắng dùng để chứa nội dung chi tiết nhà hàng. */
    .booking-panel {
        padding: 1.5rem;
        background: #fff;
        border: 1px solid #eadbcf;
        border-radius: 1rem;
    }

    /* Chia phần chi tiết thành cột ảnh, thông tin món ăn và bản đồ. */
    .ft-detail-grid {
        display: grid;
        grid-template-columns: 240px 1fr 300px;
        gap: 20px;
        align-items: stretch;
        min-height: 470px;
    }

    /* Cột thông tin nhà hàng được trải đều theo chiều dọc */
    #chi-tiet .ft-detail-grid > div:nth-child(2) {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    /* Ảnh chính của nhà hàng và phần giá tham khảo. */
    .ft-main-photo-box img {
        width: 100%;
        height: 215px;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }

    .ft-price-caption {
        margin-top: 10px;
        font-size: 0.9rem;
        color: #5c514a;
    }

        .ft-price-caption strong {
            color: #a94321;
        }

    /* Nhãn dịp phù hợp và các thẻ món ăn đặc trưng. */
    .ft-tag-pill {
        display: inline-block;
        padding: 3px 11px;
        border: 1px solid #d6c3b5;
        border-radius: 999px;
        font-size: 0.82rem;
        color: #4a3a31;
        background: #fcf9f5;
        margin-right: 6px;
        margin-bottom: 6px;
    }

    .ft-featured-dishes {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin: 8px 0 12px;
    }

    .ft-dish-card {
        border: 1px solid #efe6dc;
        border-radius: 8px;
        padding: 6px;
        background: #fffaf6;
    }

        .ft-dish-card img {
            width: 100%;
            height: 74px;
            object-fit: cover;
            border-radius: 6px;
            display: block;
        }

    .ft-dish-name {
        font-size: 0.82rem;
        font-weight: 600;
        color: #30231d;
        margin-top: 5px;
    }

    .ft-dish-price {
        font-size: 0.78rem;
        color: #a94321;
        font-weight: 600;
    }

    /* Cột bản đồ, ô nhập địa chỉ và nút ghim. */
    .ft-map-column {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ft-map-top-bar {
        display: flex;
        justify-content: flex-end;
    }

    .ft-map-box {
        border: 1px solid #e5ddd3;
        border-radius: 10px;
        overflow: hidden;
        background: #faf7f3;
    }

    .ft-map-search-row {
        display: flex;
        gap: 6px;
        padding: 8px;
        background: #fff;
        border-bottom: 1px solid #eee6dc;
    }

        .ft-map-search-row input {
            flex: 1;
            min-width: 0;
            border: 1px solid #dcd2c6;
            border-radius: 6px;
            padding: 5px 9px;
            font-size: 0.84rem;
        }

    .ft-map-frame {
        width: 100%;
        height: 155px;
    }

    .ft-map-address {
        padding: 8px 10px;
        font-size: 0.82rem;
        color: #30231d;
        background: #fff;
    }

    /* Xếp phần chi tiết thành một cột trên máy tính bảng và điện thoại. */
    @@media (max-width: 991.98px) {
        .ft-detail-grid {
            grid-template-columns: 1fr;
            min-height: 0;
            align-items: start;
        }
    }

    @@media (max-width: 576px) {
        .ft-featured-dishes {
            grid-template-columns: 1fr;
        }
    }

    /* Khung tổng thể của biểu mẫu đặt bàn ba bước */
    .booking-experience {
        display: grid;
        grid-template-columns: minmax(280px, .82fr) minmax(0, 1.18fr);
        max-width: 1180px;
        min-height: 650px;
        margin: 0 auto;
        overflow: hidden;
        background: #fff;
        border: 1px solid #eadbcf;
        border-radius: 1.25rem;
        box-shadow: 0 12px 34px rgba(74, 43, 25, .12);
    }

    /* Ảnh minh họa và dòng giới thiệu bên trái biểu mẫu. */
    .booking-visual {
        position: relative;
        min-height: 650px;
        overflow: hidden;
        background: #3b2418;
    }

        .booking-visual img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .booking-visual::after {
            position: absolute;
            inset: 0;
            content: "";
            background: linear-gradient(180deg, rgba(31, 18, 12, .05) 35%, rgba(31, 18, 12, .78) 100%);
        }

    .booking-visual-copy {
        position: absolute;
        z-index: 1;
        right: 1.75rem;
        bottom: 2rem;
        left: 1.75rem;
        color: #fff;
    }

        .booking-visual-copy h3 {
            font-family: Georgia, serif;
            font-size: clamp(1.6rem, 2.4vw, 2.25rem);
            font-weight: 700;
        }

    .booking-content {
        min-width: 0;
        padding: clamp(1.25rem, 3vw, 2.6rem);
    }

    .booking-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        color: #43271b;
        font-family: Georgia, serif;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .booking-heading {
        margin: .45rem 0 1.6rem;
        color: #43271b;
        font-family: Georgia, serif;
        font-size: clamp(1.65rem, 3vw, 2.25rem);
        font-weight: 700;
        text-align: center;
    }

    /* Thanh tiến trình và số thứ tự ba bước đặt bàn. */
    .booking-stepper {
        position: relative;
        margin: 0 0 1.8rem;
    }

    .booking-step-track {
        position: absolute;
        top: 16px;
        right: 16.5%;
        left: 16.5%;
        height: 3px;
        background: #eadbcf;
    }

    .booking-step-track-fill {
        display: block;
        width: 0;
        height: 100%;
        background: #a94321;
        transition: width .25s ease;
    }

    .booking-step-list {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .booking-step-indicator {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .45rem;
        color: #76665d;
        font-size: .88rem;
        text-align: center;
    }

    .booking-step-dot {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border: 2px solid #eadbcf;
        border-radius: 50%;
        background: #fffaf6;
        color: #6b5143;
        font-weight: 700;
        transition: all .2s ease;
    }

    .booking-step-indicator.is-active,
    .booking-step-indicator.is-complete {
        color: #a94321;
        font-weight: 700;
    }

        .booking-step-indicator.is-active .booking-step-dot,
        .booking-step-indicator.is-complete .booking-step-dot {
            border-color: #a94321;
            background: #a94321;
            color: #fff;
        }

    /* Tiêu đề và cách trình bày các ô nhập trong từng bước. */
    .booking-step-panel h3 {
        margin-bottom: 1rem;
        color: #43271b;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .booking-step-panel .form-label {
        margin-bottom: .45rem;
        color: #43271b;
        font-weight: 600;
    }

    .booking-step-panel .form-control {
        min-height: 48px;
        border-color: #ddcfc4;
        border-radius: .7rem;
    }

    .booking-step-panel textarea.form-control {
        min-height: 105px;
    }

    /* Lưới các nút chọn giờ đặt bàn nhanh. */
    .booking-time-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .55rem;
    }

    .booking-time-slot {
        min-height: 42px;
        border: 1px solid #e7d8cc;
        border-radius: .65rem;
        background: #fffaf6;
        color: #43271b;
        transition: all .18s ease;
    }

        .booking-time-slot:hover,
        .booking-time-slot.is-selected {
            border-color: #a94321;
            background: #a94321;
            color: #fff;
        }

    /* Hàng nút quay lại, tiếp tục và xác nhận. */
    .booking-step-actions {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
        margin-top: 1.5rem;
    }

        .booking-step-actions .btn {
            min-height: 48px;
            padding-inline: 1.25rem;
            border-radius: .7rem;
            font-weight: 600;
        }

    /* Bảng xem lại thông tin và thẻ báo đặt bàn thành công. */
    .booking-summary {
        padding: 1.1rem 1.25rem;
        border: 1px solid #eadbcf;
        border-radius: .9rem;
        background: #fffaf6;
    }

    .booking-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: .65rem 0;
        border-bottom: 1px solid #eadbcf;
    }

        .booking-summary-row:last-child {
            border-bottom: 0;
        }

        .booking-summary-row span:first-child {
            color: #76665d;
        }

        .booking-summary-row span:last-child {
            color: #43271b;
            font-weight: 600;
            text-align: right;
            overflow-wrap: anywhere;
        }

    .booking-success-card {
        padding: 1.5rem;
        border: 1px solid #eadbcf;
        border-radius: 1rem;
        background: #fffaf6;
        text-align: center;
    }

    .booking-success-badge {
        width: 52px;
        height: 52px;
        margin: 0 auto 0.85rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #a94321;
        color: #fff;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .booking-code-pill {
        display: inline-block;
        padding: 0.3rem 0.85rem;
        margin-bottom: 1rem;
        border-radius: 999px;
        background: #fff;
        border: 1px solid #d6c3b5;
        color: #43271b;
        font-size: 0.9rem;
        font-weight: 700;
    }

    /* Chuyển giao diện đặt bàn thành một cột trên màn hình nhỏ. */
    @@media (max-width: 767.98px) {
        .booking-experience {
            grid-template-columns: 1fr;
        }

        .booking-visual {
            min-height: 250px;
        }

        .booking-content {
            padding: 1.25rem;
        }
    }

    @@media (max-width: 420px) {
        .booking-time-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .booking-step-indicator {
            font-size: .75rem;
        }
    }

    /* Hàng biểu tượng loại ẩm thực có thể cuộn ngang. */
    .cuisine-scroll {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        overflow-x: auto;
        padding: .5rem .25rem 1rem;
    }

    .cuisine-chip {
        flex: 0 0 88px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .45rem;
        padding: .25rem;
        color: #30231d;
        background: transparent;
        border: 0;
        white-space: nowrap;
    }

    .cuisine-icon {
        width: 68px;
        height: 68px;
        display: grid;
        place-items: center;
        font-size: 2rem;
        background: #fff;
        border: 1px solid #eadbcf;
        border-radius: 50%;
        box-shadow: 0 4px 12px rgba(50, 30, 20, .15);
        transition: .2s;
    }

    .cuisine-chip:hover .cuisine-icon,
    .cuisine-chip.active .cuisine-icon {
        border-color: #a94321;
        transform: translateY(-3px);
    }

    .cuisine-chip.active .cuisine-icon {
        background: #fff0e8;
    }
    /* Chiều cao tối thiểu của khung chi tiết nhà hàng. */
    #chi-tiet .booking-panel {
        min-height: 520px;
    }
</style>

@* Banner đầu trang với các ảnh tự chuyển. *@
<section class="hero-carousel mb-4">
    <div id="heroCarousel"
         class="carousel slide hero-carousel-slides"
         data-bs-ride="carousel"
         data-bs-interval="4500">

        @* Các chấm dưới banner cho phép chuyển nhanh đến từng ảnh. *@
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Ảnh 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Ảnh 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Ảnh 3"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="@Url.Content("~/Content/IMG/Hero/restaurant-1.png")" alt="Không gian nhà hàng 1" />
            </div>
            <div class="carousel-item">
                <img src="@Url.Content("~/Content/IMG/Hero/restaurant-2.png")" alt="Không gian nhà hàng 2" />
            </div>
            <div class="carousel-item">
                <img src="@Url.Content("~/Content/IMG/Hero/restaurant-3.png")" alt="Không gian nhà hàng 3" />
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Ảnh trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Ảnh tiếp theo</span>
        </button>
    </div>

    <div class="hero-shade"></div>

    <div class="hero-content">
        <span class="badge text-bg-warning mb-3">FOODTABLE · TP. HỒ CHÍ MINH</span>
        <h1>Khám phá nhà hàng phù hợp với bạn</h1>
        <p>
            Tìm nhà hàng theo tên, khu vực và loại ẩm thực.
            Chọn địa điểm yêu thích rồi gửi yêu cầu đặt bàn.
        </p>

        <div class="row g-2 hero-search mt-4">
            <div class="col-md-8">
                <label class="visually-hidden" for="searchInput">Tìm nhà hàng</label>
                <input id="searchInput" class="form-control form-control-lg" type="search" placeholder="Ví dụ: món Việt, Quận 1, steak..." />
            </div>
            <div class="col-md-4">
                <button id="searchButton" class="btn btn-food btn-lg w-100" type="button">Tìm nhà hàng</button>
            </div>
        </div>
    </div>
</section>

@* Khu vực bộ lọc, biểu tượng ẩm thực và danh sách nhà hàng. *@
<section id="nha-hang">
    <h2 class="section-title">Tìm nhà hàng phù hợp</h2>

    @* Chọn khu vực, mức giá và dịp phù hợp; nút Bộ lọc áp dụng các lựa chọn. *@
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <label class="form-label" for="areaFilter">Khu vực</label>
            <select id="areaFilter" class="form-select">
                <option value="">Tất cả khu vực</option>
                <option value="Quận 1">Quận 1</option>
                <option value="Quận 2">Quận 2</option>
                <option value="Quận 3">Quận 3</option>
                <option value="Quận 4">Quận 4</option>
                <option value="Quận 5">Quận 5</option>
                <option value="Quận 6">Quận 6</option>
                <option value="Quận 7">Quận 7</option>
                <option value="Quận 8">Quận 8</option>
                <option value="Quận 9">Quận 9</option>
                <option value="Quận 10">Quận 10</option>
                <option value="Quận 11">Quận 11</option>
                <option value="Quận 12">Quận 12</option>
                <option value="Gò Vấp">Gò Vấp</option>
                <option value="Bình Thạnh">Bình Thạnh</option>
                <option value="Tân Bình">Tân Bình</option>
                <option value="Tân Phú">Tân Phú</option>
                <option value="Phú Nhuận">Phú Nhuận</option>
                <option value="Bình Tân">Bình Tân</option>
                <option value="Thủ Đức">Thủ Đức</option>
            </select>
        </div>

        <div class="col-sm-6 col-lg-3">
            <label class="form-label" for="priceFilter">Giá trung bình</label>
            <select id="priceFilter" class="form-select">
                <option value="">Tất cả mức giá</option>
                <option value="0-150">Dưới 150K</option>
                <option value="150-250">150K – 250K</option>
                <option value="250-500">250K – 500K</option>
                <option value="500-1000">500K – 1.000K</option>
                <option value="1000+">Trên 1.000K</option>
            </select>
        </div>

        <div class="col-sm-6 col-lg-3">
            <label class="form-label" for="purposeFilter">Phù hợp với</label>
            <select id="purposeFilter" class="form-select">
                <option value="">Mọi dịp</option>
                <option value="Ăn gia đình">Ăn gia đình</option>
                <option value="Hẹn hò">Hẹn hò</option>
                <option value="Họp nhóm">Họp nhóm</option>
                <option value="Sinh nhật">Sinh nhật</option>
                <option value="Tiếp khách">Tiếp khách</option>
                <option value="Tiệc/Hội nghị">Tiệc/Hội nghị</option>
                <option value="Tiệc ngoài trời">Tiệc ngoài trời</option>
            </select>
        </div>

        <div class="col-sm-6 col-lg-3 d-flex align-items-end">
            <button id="applyFiltersButton"
                    class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
                    type="button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <circle cx="9" cy="6" r="2"></circle>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <circle cx="15" cy="12" r="2"></circle>
                    <line x1="4" y1="18" x2="20" y2="18"></line>
                    <circle cx="11" cy="18" r="2"></circle>
                </svg>
                Bộ lọc
            </button>
        </div>
    </div>

    <input type="hidden" id="cuisineFilter" value="" />

